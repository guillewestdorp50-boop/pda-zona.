<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <queries><package android:name="com.pdazona.app" /></queries>
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <application android:allowBackup="false" android:label="PDA // ZONA · INSTALADOR" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".InstallerActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <receiver android:name=".InstallStatusReceiver" android:exported="false">
            <intent-filter>
                <action android:name="com.pdazona.installer.INSTALL_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
